# Local profile of the person working with the agent (NAME, ROLE, PROFILE): make profile
.claude/profile.env
# Personal Claude Code permissions
.claude/settings.local.json
# Active EPE change on this machine (written by make epe-new / /epe-2-plan)
.epe/
