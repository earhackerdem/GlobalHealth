.agents/skills/*-workspace/
.claude/skills/*-workspace/

# OS and editors
.DS_Store
Thumbs.db
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node (if the project uses it)
node_modules/
*.log

# Template full-stack FastAPI (build y artefactos de test)
backend/app/frontend/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
