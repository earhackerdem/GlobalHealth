# Copy this file to .claude/profile.env (ignored by git), or run `make profile`.
# The hooks read it at the start of every session and on every edit/command.
NAME=Your name
ROLE=your role in the project (author, developer, reviewer, mentor…)
# supervised -> guardrails BLOCK: no code edits without an approved plan; no push to protected branches,
#               force or merge. Delivery ends at the PR and someone else merges.
# autonomous -> the same guardrails only WARN.
# They describe the session's working mode, not the person's level.
PROFILE=supervised
