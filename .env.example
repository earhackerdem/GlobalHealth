# Copy to .env and adjust: cp .env.example .env
# .env is NOT tracked (it holds real secrets, e.g. Google OAuth).

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
# Test database (docker compose service db-test, host port 5433): ephemeral
# (tmpfs), auto-migrated by the test suite. pytest REFUSES to run without it
# or against a database whose name does not end in _test.
TEST_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/app_test

# Google OIDC (login/signup with Google); leave unset to disable the real flow
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/login/google/callback

# Key for encrypted DB columns (urlsafe base64, 32 bytes).
# Unset -> derived from SECRET_KEY (dev only, warns on startup).
# REQUIRED outside development: the app refuses to start without it.
# ENCRYPTION_KEY=
# Previous key, only while rotating ENCRYPTION_KEY (decrypt-only via
# MultiFernet); remove it once existing data has been re-encrypted.
# ENCRYPTION_KEY_PREVIOUS=
